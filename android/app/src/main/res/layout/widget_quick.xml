<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_card" android:padding="12dp">
    <LinearLayout android:id="@+id/q_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/q_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_mute" android:textSize="12sp" android:maxLines="1" android:text="Balance del mes" />
        <TextView android:id="@+id/q_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="1" android:text="Caoba" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/q_in" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="44dp"
            android:background="@drawable/w_btn_in" android:gravity="center" android:textColor="@color/w_in_ink" android:textSize="15sp" android:textStyle="bold" android:text="+ Ingreso" android:contentDescription="Agregar ingreso" />
        <TextView android:id="@+id/q_out" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:minHeight="44dp" android:layout_marginStart="8dp"
            android:background="@drawable/w_btn_out" android:gravity="center" android:textColor="@color/w_out_ink" android:textSize="15sp" android:textStyle="bold" android:text="− Gasto" android:contentDescription="Agregar gasto" />
    </LinearLayout>
</LinearLayout>
