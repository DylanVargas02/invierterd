        </LinearLayout>
        <TextView android:id="@+id/a_r1t" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/w_round" android:gravity="center" android:text="⇄" android:textColor="@color/w_ink" android:textSize="15sp" android:contentDescription="Transferir" />
        <TextView android:id="@+id/a_r1p" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/w_round" android:gravity="center" android:text="+" android:textColor="@color/w_accent" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Agregar ingreso a esta cuenta" />
        <TextView android:id="@+id/a_r1m" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/w_round" android:gravity="center" android:text="−" android:textColor="@color/w_out_ink" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Agregar gasto de esta cuenta" />
