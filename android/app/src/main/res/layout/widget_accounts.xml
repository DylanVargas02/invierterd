    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/a_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="14sp" android:textStyle="bold" android:text="Cuentas" />
        <TextView android:id="@+id/a_upd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_mute" android:textSize="11sp" android:text="" />
    </LinearLayout>
    <TextView android:id="@+id/a_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/w_mute" android:textSize="13sp" android:text="Abre Caoba para ver tus cuentas" android:visibility="gone" />
    <LinearLayout android:id="@+id/a_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:paddingBottom="7dp" android:visibility="gone">
